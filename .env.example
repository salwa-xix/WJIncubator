# ---------------------------------------------------------------------------
# WJIncubator Mentor Booking — environment
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" (publishable) key. This key is PUBLIC by design — it ships to
# the browser. Every table denies access to it via RLS; the app reaches data
# only through SECURITY DEFINER RPCs. Never put the service-role key here.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only — used by the seeding/asset scripts in ./scripts.
# NOT prefixed with VITE_, so Vite will never expose these to the browser.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
